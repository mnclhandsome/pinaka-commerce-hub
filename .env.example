NODE_ENV=development
GATEWAY_PORT=3000
CONNECTOR_SERVICE_PORT=3001
ORDER_SERVICE_PORT=3002
MERCHANT_SERVICE_PORT=3003
MENU_SERVICE_PORT=3004
INVENTORY_SERVICE_PORT=3005
ANALYTICS_SERVICE_PORT=3006
NOTIFICATION_SERVICE_PORT=3008
ADMIN_API_PORT=3009
AUTH_SERVICE_PORT=3010
MAIL_MODE=mock
AUTH_JWT_SECRET=replace-with-a-long-random-secret
# Optional. If omitted, merchant-service derives a 32-byte key from AUTH_JWT_SECRET.
STORE_CONFIG_ENCRYPTION_KEY=
AUTH_WEB_URL=http://localhost:3010
ORDEROUT_POS_API_KEY=replace-with-a-new-random-api-key
GOOGLE_CLIENT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=OrderOut <no-reply@example.com>
MAIL_REPLY_TO=
RESEND_API_KEY=
# Dedicated host port avoids conflicts with a Windows PostgreSQL installation.
# PostgreSQL is published on port 5432 by Docker Compose.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=pdh_user
POSTGRES_PASSWORD=pdh_password
POSTGRES_DB=pinaka_commerce_hub_new
DATABASE_URL=postgresql://pdh_user:pdh_password@127.0.0.1:5432/pinaka_commerce_hub_new
REDIS_URL=redis://localhost:6379
MESSAGE_BROKER_TYPE=kafka
KAFKA_BROKERS=localhost:9092
RABBITMQ_URL=amqp://guest:guest@localhost:5672
LOG_LEVEL=debug
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
POS_ORDERS_URL=https://merchantrestaurant.alektasolutions.com/wp-json/pinaka-restaurant-pos/v1/orders
POS_RESTAURANT_ID=1
POS_CAPTAIN_ID=1
POS_DEFAULT_PRODUCT_ID=1652
POS_API_TOKEN=
