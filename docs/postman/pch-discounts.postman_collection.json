{
  "info": {
    "_postman_id": "c5914c51-8b95-47a5-a1de-9a3111a20031",
    "name": "PCH WooCommerce Discounts",
    "description": "Backend requests for Auto, Mix & Match, and Multipack discounts. Uses the authenticated PCH API on localhost:3003. Set storeId and token before sending requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3003" },
    { "key": "storeId", "value": "YOUR_STORE_ID" },
    { "key": "token", "value": "YOUR_PCH_ACCESS_TOKEN" },
    { "key": "discountId", "value": "WORDPRESS_DISCOUNT_ID" },
    { "key": "discountType", "value": "auto", "description": "Set to auto, mix_match, or multipack for the shared discount get, update, and delete requests." },
    { "key": "orderId", "value": "WORDPRESS_ORDER_ID" }
  ],
  "item": [
    {
      "name": "Store Discount Sync",
      "item": [
        {
          "name": "Pull discounts from WooCommerce",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/stores/{{storeId}}/catalog/sync/discounts",
            "description": "Manually pulls the connected store's Auto, Mix & Match, and Multipack discount records into PCH. The connection URL and JWT are read from the saved Website Connection."
          }
        }
      ]
    },
    {
      "name": "Shared Discount CRUD (select type)",
      "description": "Set {{discountType}} to auto, mix_match, or multipack. Create selects the type in the JSON body; get, update, and delete select it in the existing :type route segment.",
      "item": [
        {
          "name": "Create discount (selected type)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Accept", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"type\": \"{{discountType}}\",\n  \"code\": \"PCH Shared Discount\",\n  \"discount_type\": \"percent\",\n  \"amount\": 10,\n  \"product_id\": 123,\n  \"product_ids\": [123],\n  \"minimum_amount\": 0,\n  \"maximum_amount\": 0,\n  \"min_qty\": 1,\n  \"max_qty\": 0,\n  \"usage_limit\": 0,\n  \"date_starts\": \"\",\n  \"date_expires\": \"\",\n  \"pinaka_discount_auto_apply\": \"yes\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/v1/stores/{{storeId}}/discounts",
            "description": "Use the fields appropriate to the selected type. Mix & Match commonly uses discount_product_ids; Multipack uses qty. PCH includes the resolved id in a successful Multipack create response."
          }
        },
        {
          "name": "Get discount (selected type and ID)",
          "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }], "url": "{{baseUrl}}/api/v1/stores/{{storeId}}/discounts/{{discountType}}/{{discountId}}" }
        },
        {
          "name": "Update discount (selected type and ID)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Accept", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"code\": \"PCH Shared Discount Updated\",\n  \"discount_type\": \"percent\",\n  \"amount\": 15,\n  \"product_id\": 123,\n  \"product_ids\": [123],\n  \"minimum_amount\": 0,\n  \"maximum_amount\": 0,\n  \"min_qty\": 1,\n  \"max_qty\": 0,\n  \"usage_limit\": 0,\n  \"date_starts\": \"\",\n  \"date_expires\": \"\",\n  \"pinaka_discount_auto_apply\": \"yes\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/v1/stores/{{storeId}}/discounts/{{discountType}}/{{discountId}}"
          }
        },
        {
          "name": "Delete discount (selected type and ID)",
          "request": { "method": "DELETE", "header": [{ "key": "Accept", "value": "application/json" }], "url": "{{baseUrl}}/api/v1/stores/{{storeId}}/discounts/{{discountType}}/{{discountId}}" }
        }
      ]
    },
    {
      "name": "Shared Discount List - Type Filtering",
      "description": "Uses the shared GET /discounts endpoint. Change the type query value to auto, mix_match, or multipack. The response is data[] plus the source pagination object.",
      "item": [
        {
          "name": "Get all discounts (no type filter)",
          "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }], "url": "{{baseUrl}}/api/v1/stores/{{storeId}}/discounts?page=1&per_page=10" }
        },
        {
          "name": "Filter discounts by Auto type",
          "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }], "url": "{{baseUrl}}/api/v1/stores/{{storeId}}/discounts?type=auto&page=1&per_page=10" }
        },
        {
          "name": "Filter discounts by Mix & Match type",
          "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }], "url": "{{baseUrl}}/api/v1/stores/{{storeId}}/discounts?type=mix_match&page=1&per_page=10" }
        },
        {
          "name": "Filter discounts by Multipack type",
          "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }], "url": "{{baseUrl}}/api/v1/stores/{{storeId}}/discounts?type=multipack&page=1&per_page=10" }
        }
      ]
    },
    {
      "name": "Other Discount APIs",
      "item": [
        {
          "name": "Get discount rules projection",
          "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }], "url": "{{baseUrl}}/api/v1/stores/{{storeId}}/discount-rules", "description": "Returns the source assets/discount-rules top-level array." }
        },
        {
          "name": "Get products by IDs",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Accept", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"ids\": [123, 124]\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/v1/stores/{{storeId}}/discounts/by-ids" }
        },
        {
          "name": "Apply custom discount to order",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Accept", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"discount_code\": \"SAVE10\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/v1/stores/{{storeId}}/discounts/apply/{{orderId}}" }
        },
        {
          "name": "Remove custom discount from order",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Accept", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"discount_code\": \"SAVE10\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/v1/stores/{{storeId}}/discounts/remove/{{orderId}}" }
        }
      ]
    },
    {
      "name": "Auto Discounts",
      "item": [
        {
          "name": "List discounts (all types)",
          "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }], "url": "{{baseUrl}}/api/v1/stores/{{storeId}}/discounts" }
        },
        {
          "name": "Get all Auto discounts",
          "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }], "url": "{{baseUrl}}/api/v1/stores/{{storeId}}/discounts/auto", "description": "Returns only Auto discount records as data[], with pagination when supplied by WooCommerce." }
        },
        {
          "name": "Get Auto discount by ID",
          "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }], "url": "{{baseUrl}}/api/v1/stores/{{storeId}}/discounts/auto/{{discountId}}" }
        },
        {
          "name": "Create Auto discount",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Accept", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"type\": \"auto\",\n  \"code\": \"PCH Auto Discount\",\n  \"discount_type\": \"percent\",\n  \"amount\": 10,\n  \"product_id\": 123,\n  \"product_ids\": [123],\n  \"minimum_amount\": 0,\n  \"maximum_amount\": 0,\n  \"min_qty\": 1,\n  \"max_qty\": 0,\n  \"usage_limit\": 0,\n  \"date_starts\": \"\",\n  \"date_expires\": \"\",\n  \"pinaka_discount_auto_apply\": \"yes\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/v1/stores/{{storeId}}/discounts"
          }
        },
        {
          "name": "Update Auto discount",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Accept", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"code\": \"PCH Auto Discount Updated\",\n  \"discount_type\": \"percent\",\n  \"amount\": 15,\n  \"product_id\": 123,\n  \"product_ids\": [123],\n  \"minimum_amount\": 0,\n  \"maximum_amount\": 0,\n  \"min_qty\": 1,\n  \"max_qty\": 0,\n  \"usage_limit\": 0,\n  \"date_starts\": \"\",\n  \"date_expires\": \"\",\n  \"pinaka_discount_auto_apply\": \"yes\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/v1/stores/{{storeId}}/discounts/auto/{{discountId}}"
          }
        },
        {
          "name": "Delete Auto discount",
          "request": { "method": "DELETE", "header": [{ "key": "Accept", "value": "application/json" }], "url": "{{baseUrl}}/api/v1/stores/{{storeId}}/discounts/auto/{{discountId}}" }
        }
      ]
    },
    {
      "name": "Mix & Match Discounts",
      "item": [
        {
          "name": "Get all Mix & Match discounts",
          "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }], "url": "{{baseUrl}}/api/v1/stores/{{storeId}}/discounts/mix_match", "description": "Returns only Mix & Match discount records as data[], with pagination when supplied by WooCommerce." }
        },
        {
          "name": "Get Mix & Match discount by ID",
          "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }], "url": "{{baseUrl}}/api/v1/stores/{{storeId}}/discounts/mix_match/{{discountId}}" }
        },
        {
          "name": "Create Mix & Match discount",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Accept", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"type\": \"mix_match\",\n  \"code\": \"PCH Mix Match\",\n  \"discount_type\": \"fixed_item\",\n  \"amount\": 5,\n  \"product_id\": 123,\n  \"discount_product_ids\": [124, 125],\n  \"minimum_amount\": 0,\n  \"maximum_amount\": 0,\n  \"min_qty\": 0,\n  \"max_qty\": 0,\n  \"usage_limit\": 0,\n  \"date_starts\": \"\",\n  \"date_expires\": \"\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/v1/stores/{{storeId}}/discounts"
          }
        },
        {
          "name": "Update Mix & Match discount",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Accept", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"code\": \"PCH Mix Match Updated\",\n  \"discount_type\": \"fixed_item\",\n  \"amount\": 7,\n  \"product_id\": 123,\n  \"discount_product_ids\": [124, 125],\n  \"minimum_amount\": 0,\n  \"maximum_amount\": 0,\n  \"min_qty\": 0,\n  \"max_qty\": 0,\n  \"usage_limit\": 0,\n  \"date_starts\": \"\",\n  \"date_expires\": \"\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/v1/stores/{{storeId}}/discounts/mix_match/{{discountId}}"
          }
        },
        {
          "name": "Delete Mix & Match discount",
          "request": { "method": "DELETE", "header": [{ "key": "Accept", "value": "application/json" }], "url": "{{baseUrl}}/api/v1/stores/{{storeId}}/discounts/mix_match/{{discountId}}" }
        }
      ]
    },
    {
      "name": "Multipack Discounts",
      "item": [
        {
          "name": "Get all Multipack discounts",
          "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }], "url": "{{baseUrl}}/api/v1/stores/{{storeId}}/discounts/multipack", "description": "Returns only Multipack discount records as data[], with pagination when supplied by WooCommerce." }
        },
        {
          "name": "Get Multipack discount by ID",
          "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }], "url": "{{baseUrl}}/api/v1/stores/{{storeId}}/discounts/multipack/{{discountId}}" }
        },
        {
          "name": "Create Multipack discount",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Accept", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"type\": \"multipack\",\n  \"code\": \"PCH Multipack\",\n  \"discount_type\": \"percent\",\n  \"amount\": 10,\n  \"product_id\": 123,\n  \"qty\": 3,\n  \"usage_limit\": 0,\n  \"date_starts\": \"\",\n  \"date_expires\": \"\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/v1/stores/{{storeId}}/discounts"
          }
        },
        {
          "name": "Update Multipack discount",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Accept", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"code\": \"PCH Multipack Updated\",\n  \"discount_type\": \"percent\",\n  \"amount\": 15,\n  \"product_id\": 123,\n  \"qty\": 3,\n  \"usage_limit\": 0,\n  \"date_starts\": \"\",\n  \"date_expires\": \"\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/v1/stores/{{storeId}}/discounts/multipack/{{discountId}}"
          }
        },
        {
          "name": "Delete Multipack discount",
          "request": { "method": "DELETE", "header": [{ "key": "Accept", "value": "application/json" }], "url": "{{baseUrl}}/api/v1/stores/{{storeId}}/discounts/multipack/{{discountId}}", "description": "The plugin refuses deletion when the Multipack rule has already been used. In that case PCH returns an error and retains the local record." }
        }
      ]
    }
  ]
}
